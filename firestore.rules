rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isMe(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function ownsCurrentDoc() {
      return signedIn() &&
        (
          resource.data.uid == request.auth.uid ||
          resource.data.userId == request.auth.uid ||
          resource.data.authorUid == request.auth.uid ||
          resource.data.ownerUid == request.auth.uid ||
          resource.data.senderUid == request.auth.uid ||
          resource.data.senderId == request.auth.uid
        );
    }

    function ownsNewDoc() {
      return signedIn() &&
        (
          request.resource.data.uid == request.auth.uid ||
          request.resource.data.userId == request.auth.uid ||
          request.resource.data.authorUid == request.auth.uid ||
          request.resource.data.ownerUid == request.auth.uid ||
          request.resource.data.senderUid == request.auth.uid ||
          request.resource.data.senderId == request.auth.uid
        );
    }

    function isConversationParticipant() {
      return signedIn() &&
        (
          request.auth.uid in resource.data.participants ||
          request.auth.uid in resource.data.members
        );
    }

    function isNewConversationParticipant() {
      return signedIn() &&
        (
          request.auth.uid in request.resource.data.participants ||
          request.auth.uid in request.resource.data.members
        );
    }

    function validMessageFields() {
      return request.resource.data.keys().hasOnly([
        'chatId',
        'senderUid',
        'receiverUid',
        'senderId',
        'receiverId',
        'participants',
        'members',
        'text',
        'type',
        'url',
        'preview',
        'musicTitle',
        'musicArtist',
        'read',
        'createdAt',
        'updatedAt'
      ]);
    }

    function isNewMessageSender() {
      return signedIn() &&
        (
          request.resource.data.senderUid == request.auth.uid ||
          request.resource.data.senderId == request.auth.uid
        );
    }

    function isCurrentMessageParticipant() {
      return signedIn() &&
        (
          resource.data.senderUid == request.auth.uid ||
          resource.data.receiverUid == request.auth.uid ||
          resource.data.senderId == request.auth.uid ||
          resource.data.receiverId == request.auth.uid ||
          request.auth.uid in resource.data.participants ||
          request.auth.uid in resource.data.members
        );
    }

    /* USERS / PROFILE */
    match /users/{userId} {
      allow read: if signedIn();
      allow create: if isMe(userId);
      allow update: if isMe(userId);
      allow delete: if isMe(userId);

      match /private/{privateDocId} {
        allow read, create, update, delete: if isMe(userId);
      }

      match /userControls/{targetUid} {
        allow read: if signedIn()
          && (
            request.auth.uid == userId ||
            request.auth.uid == targetUid
          );

        allow create, update: if isMe(userId)
          && userId != targetUid
          && request.resource.data.targetUid == targetUid
          && request.resource.data.keys().hasOnly([
            'targetUid',
            'muted',
            'hidden',
            'blocked',
            'muteUntil',
            'hideUntil',
            'blockUntil',
            'createdAt',
            'updatedAt'
          ]);

        allow delete: if isMe(userId);
      }

      match /favorites/{favoriteId} {
        allow read: if signedIn();
        allow create, update, delete: if isMe(userId);
      }

      match /reviews/{reviewId} {
        allow read: if signedIn();
        allow create, update, delete: if isMe(userId);
      }

      match /followers/{followerUid} {
        allow read: if signedIn();

        allow create: if signedIn()
          && request.auth.uid == followerUid
          && request.auth.uid != userId;

        allow delete: if signedIn()
          && request.auth.uid == followerUid;

        allow update: if false;
      }

      match /following/{followingUid} {
        allow read: if signedIn();

        allow create: if signedIn()
          && request.auth.uid == userId
          && request.auth.uid != followingUid;

        allow delete: if signedIn()
          && request.auth.uid == userId;

        allow update: if false;
      }
    }

    /* USERNAMES */
    match /usernames/{username} {
      allow read: if signedIn();

      allow create, update: if signedIn()
        && request.resource.data.uid == request.auth.uid;

      allow delete: if signedIn()
        && resource.data.uid == request.auth.uid;
    }

    /* FOLLOW REQUESTS */
    match /followRequests/{requestId} {
      allow read: if signedIn()
        && (
          resource.data.fromUid == request.auth.uid ||
          resource.data.toUid == request.auth.uid
        );

      allow create: if signedIn()
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.toUid != request.auth.uid
        && request.resource.data.status == "pending";

      allow update: if signedIn()
        && (
          resource.data.fromUid == request.auth.uid ||
          resource.data.toUid == request.auth.uid
        );

      allow delete: if signedIn()
        && (
          resource.data.fromUid == request.auth.uid ||
          resource.data.toUid == request.auth.uid
        );
    }

    /* POSTS */
    match /posts/{postId} {
      allow read: if signedIn();
      allow create: if ownsNewDoc();
      allow update: if ownsCurrentDoc();
      allow delete: if ownsCurrentDoc();

      match /comments/{commentId} {
        allow read: if signedIn();
        allow create: if ownsNewDoc();
        allow update, delete: if ownsCurrentDoc();
      }

      match /likes/{likeId} {
        allow read: if signedIn();
        allow create: if signedIn();
        allow delete: if signedIn();
        allow update: if false;
      }
    }

    /* COMMENTS GLOBAL */
    match /comments/{commentId} {
      allow read: if signedIn();
      allow create: if ownsNewDoc();
      allow update, delete: if ownsCurrentDoc();
    }

    /* LIKES GLOBAL */
    match /likes/{likeId} {
      allow read: if signedIn();

      allow create: if signedIn()
        && (
          request.resource.data.uid == request.auth.uid ||
          request.resource.data.userId == request.auth.uid ||
          request.resource.data.authorUid == request.auth.uid
        );

      allow delete: if signedIn()
        && (
          resource.data.uid == request.auth.uid ||
          resource.data.userId == request.auth.uid ||
          resource.data.authorUid == request.auth.uid
        );

      allow update: if false;
    }

    /* STORIES */
    match /stories/{storyId} {
      allow read: if signedIn();
      allow create: if ownsNewDoc();
      allow update, delete: if ownsCurrentDoc();
    }

    /* REVIEWS GLOBAL */
    match /reviews/{reviewId} {
      allow read: if signedIn();
      allow create: if ownsNewDoc();
      allow update, delete: if ownsCurrentDoc();
    }

    /* FEED */
    match /feed/{feedId} {
      allow read: if signedIn();
      allow create: if ownsNewDoc();
      allow update, delete: if ownsCurrentDoc();
    }

    /* FOLLOWS GLOBAL */
    match /follows/{followId} {
      allow read: if signedIn();

      allow create: if signedIn()
        && request.resource.data.followerUid == request.auth.uid
        && request.resource.data.followingUid != request.auth.uid;

      allow delete: if signedIn()
        && resource.data.followerUid == request.auth.uid;

      allow update: if false;
    }

    /* FOLLOWERS GLOBAL */
    match /followers/{docId} {
      allow read: if signedIn();

      allow create: if signedIn()
        && (
          request.resource.data.followerUid == request.auth.uid ||
          request.resource.data.uid == request.auth.uid ||
          request.resource.data.userId == request.auth.uid
        );

      allow delete: if signedIn()
        && (
          resource.data.followerUid == request.auth.uid ||
          resource.data.uid == request.auth.uid ||
          resource.data.userId == request.auth.uid
        );

      allow update: if false;
    }

    /* FOLLOWING GLOBAL */
    match /following/{docId} {
      allow read: if signedIn();

      allow create: if signedIn()
        && (
          request.resource.data.uid == request.auth.uid ||
          request.resource.data.userId == request.auth.uid ||
          request.resource.data.followerUid == request.auth.uid
        );

      allow delete: if signedIn()
        && (
          resource.data.uid == request.auth.uid ||
          resource.data.userId == request.auth.uid ||
          resource.data.followerUid == request.auth.uid
        );

      allow update: if false;
    }

    /* MESSAGES GLOBAL */
    match /messages/{messageId} {
      allow read: if isCurrentMessageParticipant();

      allow create: if isNewMessageSender()
        && validMessageFields()
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.receiverUid in request.resource.data.participants
        && request.resource.data.receiverUid != request.auth.uid;

      allow update, delete: if isCurrentMessageParticipant();
    }

    /* CONVERSATIONS */
    match /conversations/{conversationId} {
      allow read: if isConversationParticipant();
      allow create: if isNewConversationParticipant();
      allow update: if isConversationParticipant();
      allow delete: if isConversationParticipant();

      match /messages/{messageId} {
        allow read: if signedIn()
          && (
            request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants ||
            request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.members
          );

        allow create: if isNewMessageSender()
          && validMessageFields()
          && (
            request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants ||
            request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.members
          );

        allow update, delete: if signedIn()
          && (
            request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants ||
            request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.members
          );
      }
    }

    /* CHATS */
    match /chats/{chatId} {
      allow read: if signedIn()
        && (
          request.auth.uid in resource.data.members ||
          request.auth.uid in resource.data.participants
        );

      allow create: if signedIn()
        && (
          request.auth.uid in request.resource.data.members ||
          request.auth.uid in request.resource.data.participants
        );

      allow update, delete: if signedIn()
        && (
          request.auth.uid in resource.data.members ||
          request.auth.uid in resource.data.participants
        );

      match /messages/{messageId} {
        allow read: if signedIn()
          && (
            request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.members ||
            request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants
          );

        allow create: if isNewMessageSender()
          && validMessageFields()
          && (
            request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.members ||
            request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants
          );

        allow update, delete: if signedIn()
          && (
            request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.members ||
            request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants
          );
      }
    }

    /* NOTIFICATIONS */
    match /notifications/{notificationId} {
      allow read: if signedIn()
        && (
          resource.data.uid == request.auth.uid ||
          resource.data.userId == request.auth.uid ||
          resource.data.receiverUid == request.auth.uid ||
          resource.data.toUserId == request.auth.uid
        );

      allow create: if signedIn();

      allow update, delete: if signedIn()
        && (
          resource.data.uid == request.auth.uid ||
          resource.data.userId == request.auth.uid ||
          resource.data.receiverUid == request.auth.uid ||
          resource.data.toUserId == request.auth.uid
        );
    }

    /* REPORTS */
    match /reports/{reportId} {
      allow create: if signedIn();
      allow read, update, delete: if false;
    }

    /* DEFAULT BLOCK */
    match /{document=**} {
      allow read, write: if false;
    }
  }
}